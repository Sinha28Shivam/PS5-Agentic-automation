# Copy to .env and fill in. .env is gitignored - never commit real keys.
#
# Paste your key after the '=' with no quotes and no spaces, e.g.
#   ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx
#
# NOTE: if ANTHROPIC_API_KEY is already set in your environment, that one wins.

ANTHROPIC_API_KEY=
# Optional: force a specific model instead of auto-detecting.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional overrides used by PS5-Agentic-Testing/config/settings.yaml
# AUTOMATION_ROOT=../PS5-Automation-Python
# CONTROLS_CONFIG=../PS5-Automation-Python/config/controls.yaml
