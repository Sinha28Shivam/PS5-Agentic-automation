# ===========================================================================
#  .gitignore
#
#  Commit anything a human wrote or that describes how the rig behaves;
#  ignore anything a RUN produced.
# ===========================================================================

# --- secrets ---------------------------------------------------------------
# .env.example IS committed (it documents the variables); real keys never are.
.env
*.env
!.env.example

# --- run artifacts ---------------------------------------------------------
# Proof runs write to PS5-Automation-Python/artifacts/, agent runs to PS5-Agentic-Testing/artifacts/.
artifacts/
PS5-Agentic-Testing/artifacts/
PS5-Agentic-Testing/scratch/
PS5-Agentic-Testing/**/checkpoints.sqlite
_live.txt
_lastrun.txt

# --- captured frames -------------------------------------------------------
# Ignored everywhere EXCEPT docs/, where reference frames are committed on purpose.
*.png
!**/docs/**/*.png

# --- temporary / experimental ----------------------------------------------
TEMP_*
temp_*/

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- editors / OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# --- model caches ----------------------------------------------------------
# PaddleOCR downloads ~200MB of models on first use.
.paddleocr/
paddleocr_models/
